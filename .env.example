# Riwaq — environment template.
# Copy to `.env.local` and fill in. Every variable here is read in exactly one place, `lib/env.ts`;
# nothing else in the app touches `process.env`.
#
# Variables marked REQUIRED are validated at module load, so a missing one fails the build rather
# than surfacing at runtime.

# ── Database ────────────────────────────────────────────────────────────────
# REQUIRED. Postgres connection string used by Drizzle.
DATABASE_URL=postgresql://user:password@localhost:5432/riwaq

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED. Signing secret for Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-string

# REQUIRED in production. Falls back to http://localhost:3000, which means a missing value in a
# deployed environment builds fine and then breaks auth callbacks silently. Set the real origin.
BETTER_AUTH_URL=http://localhost:3000

# Optional. Omit both to disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# Optional. Without it, password-reset and verification mail is logged instead of sent.
RESEND_API_KEY=

# REQUIRED. Falls back to a Resend sandbox sender, which only delivers to your own address.
EMAIL_FROM=Riwaq <onboarding@resend.dev>

# ── AI ──────────────────────────────────────────────────────────────────────
# Optional. Without it, task time estimates and "Break into steps" return null and the UI degrades
# quietly rather than erroring.
GEMINI_API_KEY=
